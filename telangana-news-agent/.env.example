# Copy to .env for local runs. Names only: NEVER commit real values.
# In Cloud Run these come from Secret Manager (see deployment/cloud_run_scheduler.md).

# --- Safety switches ---
DRY_RUN=true                       # true = write email previews to ./out, send nothing
EMAIL_RECIPIENT_ALLOWLIST=         # comma-separated; live sends to anyone else are refused

# --- Storage ---
# Local default (unset) = sqlite:///local.db
# Supabase: Project Settings -> Database -> Connection string -> "Session pooler" (IPv4)
DATABASE_URL=

# --- AI: set ONE key (or force with LLM_PROVIDER=gemini|groq|none) ---
LLM_PROVIDER=
GROQ_API_KEY=                      # https://console.groq.com/keys
GROQ_MODEL=                        # optional override of config/pipeline.yaml
GEMINI_API_KEY=                    # https://aistudio.google.com/apikey
GEMINI_MODEL=

# --- Optional search ---
TAVILY_API_KEY=                    # also set tavily.enabled: true in config/pipeline.yaml

# --- Email ---
EMAIL_SENDER=                      # the mailbox that sends (must match the OAuth identity)
EMAIL_TEAM_RECIPIENTS=             # comma-separated: digest + auto-approved alerts
EMAIL_REVIEWER_RECIPIENTS=         # comma-separated: alerts needing human review

# Option A: OAuth refresh token (run scripts/gmail_auth.py once)
GMAIL_CLIENT_ID=
GMAIL_CLIENT_SECRET=
GMAIL_REFRESH_TOKEN=
# Option B: Google Workspace service account with domain-wide delegation (admin approval needed)
GMAIL_SERVICE_ACCOUNT_JSON=
GMAIL_DELEGATED_USER=

LOG_LEVEL=INFO
